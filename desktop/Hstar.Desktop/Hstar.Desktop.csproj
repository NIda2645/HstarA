<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hstar</AssemblyName>
    <RootNamespace>Hstar.Desktop</RootNamespace>
    <ApplicationIcon>Branding\Hstar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\startup\index.html" LogicalName="Hstar.Desktop.StartupAssets.index.html" />
    <EmbeddedResource Include="Assets\startup\startup.css" LogicalName="Hstar.Desktop.StartupAssets.startup.css" />
    <EmbeddedResource Include="Assets\startup\startup.js" LogicalName="Hstar.Desktop.StartupAssets.startup.js" />
    <EmbeddedResource Include="Assets\startup\ogl.mjs" LogicalName="Hstar.Desktop.StartupAssets.ogl.mjs" />
    <EmbeddedResource Include="Assets\startup\ogl.LICENSE.txt" LogicalName="Hstar.Desktop.StartupAssets.ogl.LICENSE.txt" />
  </ItemGroup>
</Project>
