<Window x:Class="Hstar.Desktop.Views.StorageSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hstar 首次设置"
        Width="720"
        Height="520"
        MinWidth="620"
        MinHeight="470"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CDD3DA" />
            <Setter Property="Foreground" Value="#262B31" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#171A1F" />
            <Setter Property="BorderBrush" Value="#171A1F" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#15181D">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Hstar"
                               Foreground="#F4F6F8"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="首次设置"
                               Margin="0,4,0,0"
                               Foreground="#AEB5BF"
                               FontSize="12" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="Windows 11"
                           Foreground="#C7CCD3"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="36,30,36,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="选择 Hstar 数据位置"
                       Foreground="#171A1F"
                       FontSize="25"
                       FontWeight="Bold" />
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       Text="画布、项目、素材、输出和软件数据将保存在这里。更新或重新安装不会覆盖此位置。"
                       Foreground="#606873"
                       FontSize="13"
                       LineHeight="21"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="2"
                       Margin="0,25,0,8"
                       Text="数据位置"
                       Foreground="#30353C"
                       FontSize="12"
                       FontWeight="SemiBold" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Height="44"
                        Background="#FFFFFF"
                        BorderBrush="#C9D0D8"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBox x:Name="DataPathTextBox"
                             Padding="12,0"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#171A1F"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             TextChanged="DataPathTextBox_OnTextChanged" />
                </Border>
                <Button Grid.Column="2"
                        Style="{StaticResource SecondaryButton}"
                        Height="44"
                        Content="选择文件夹"
                        Click="BrowseButton_OnClick" />
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="PathStatusDot"
                             Grid.Column="0"
                             Width="8"
                             Height="8"
                             Fill="#7B8490"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="PathStatusText"
                               Grid.Column="2"
                               Foreground="#5D6570"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="FreeSpaceText"
                               Grid.Column="3"
                               Foreground="#3E454E"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
                <Border Margin="0,22,0,0"
                        Padding="16,13"
                        Background="#E9EEF4"
                        BorderBrush="#D5DCE4"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock Text="可以选择空目录、普通非空目录或已有 Hstar 数据目录。切换位置不会迁移、覆盖或删除其他位置的数据。"
                               Foreground="#505964"
                               FontSize="12"
                               LineHeight="19"
                               TextWrapping="Wrap" />
                </Border>
                <TextBlock x:Name="ValidationText"
                           Margin="0,12,0,0"
                           Foreground="#B42318"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DCE1E6"
                BorderThickness="0,1,0,0">
            <Grid Margin="36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Content="退出"
                        Click="CancelButton_OnClick" />
                <Button x:Name="ConfirmButton"
                        Grid.Column="3"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="142"
                        Content="开始使用 Hstar"
                        IsDefault="True"
                        Click="ConfirmButton_OnClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
