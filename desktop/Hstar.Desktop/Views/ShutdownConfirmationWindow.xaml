<Window x:Class="Hstar.Desktop.Views.ShutdownConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认关闭 Hstar"
        Width="430"
        Height="236"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4E5968" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <StackPanel Margin="30,28,30,22">
            <TextBlock Text="确认关闭 Hstar"
                       Foreground="#181B20"
                       FontSize="20"
                       FontWeight="Bold" />
            <TextBlock Margin="0,12,0,0"
                       Text="关闭后，正在运行的任务将停止。已保存的画布和软件数据不会受到影响。"
                       Foreground="#5C6470"
                       FontSize="13"
                       LineHeight="21"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#D9DDE3"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Margin="0,0,10,0"
                        Background="#FFFFFF"
                        BorderBrush="#C9CED6"
                        Foreground="#252A31"
                        Content="取消"
                        IsCancel="True"
                        IsDefault="True"
                        Click="CancelButton_OnClick" />
                <Button Background="#1A1D22"
                        BorderBrush="#1A1D22"
                        Foreground="#FFFFFF"
                        Content="关闭 Hstar"
                        Click="CloseButton_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
