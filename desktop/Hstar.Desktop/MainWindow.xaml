<Window x:Class="Hstar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Hstar"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#000018">
    <Grid Background="#000018" ClipToBounds="True">
        <wv2:WebView2 x:Name="MainWebView"
                     Width="1"
                     Height="1"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     DefaultBackgroundColor="#000018"
                     IsHitTestVisible="False" />
        <wv2:WebView2CompositionControl x:Name="StartupWebView"
                                        Panel.ZIndex="20"
                                        DefaultBackgroundColor="#000018" />
        <Image x:Name="StartupFirstFrame"
               Panel.ZIndex="30"
               Source="/Hstar;component/Assets/startup/startup-first-frame.png"
               Stretch="UniformToFill"
               IsHitTestVisible="False" />
    </Grid>
</Window>
